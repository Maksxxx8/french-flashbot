# ======================================================
# Переменные окружения для Flashbot (Французский / Париж)
# ======================================================
# Скопируй этот файл в .env и заполни свои значения:
#   cp .env.example .env

# --- Telegram ---
# Токен твоего Telegram-бота (получить через @BotFather)
BOT_TOKEN_ENG=your_telegram_bot_token_here

# --- Gemini API (Google AI Studio) ---
# Получить ключ: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Модели Gemini (по умолчанию gemini-3.6-flash) ---
MODEL_BASE=gemini-3.6-flash
MODEL_SUBSTITUTE=gemini-3.6-flash


# --- Путь к папке с данными пользователя ---
# По умолчанию: ./resources
# CH_USER_DATA_ROOT=resources

# --- Часовой пояс (если нужно переопределить) ---
# TIMEZONE=Europe/Moscow

# --- Suno API (только если используешь функцию "Песня дня") ---
# SUNO_API_KEY=your_suno_key_here
